{
  "redirects": [
    {
      "source": "/blogs",
      "destination": "/blogs/",
      "permanent": true
    },
    {
      "source": "/community",
      "destination": "/community/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
