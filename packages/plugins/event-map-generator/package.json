{
  "name": "@ayu-sh-kr/dota-event-map-generator",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "version": "0.0.2",
  "description": "Vite plugin scaffold for generating typed ApplicationEventMap declaration files from Dota application sources.",
  "author": {
    "name": "ayu-sh-kr",
    "email": "akjaiswal2003@gmail.com",
    "url": "https://linkedin.com/in/ayu-sh-kr"
  },
  "license": "MIT",
  "keywords": [
    "vite-plugin",
    "dota",
    "events",
    "application-event-map",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ayu-sh-kr/dota-workspace.git"
  },
  "homepage": "https://github.com/ayu-sh-kr/dota-workspace#readme",
  "bugs": {
    "url": "https://github.com/ayu-sh-kr/dota-workspace/issues"
  },
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module": "./dist/index.mjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && vite build",
    "release": "pnpm run build && changeset publish",
    "test": "tsc --noEmit && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ayu-sh-kr/dota-ast-utils": "workspace:*",
    "@swc/core": "^1.13.5",
    "consola": "3.4.2",
    "fast-glob": "^3.3.3"
  },
  "peerDependencies": {
    "vite": "^7.1.0"
  },
  "files": [
    "dist/",
    "README.md",
    "package.json"
  ]
}
