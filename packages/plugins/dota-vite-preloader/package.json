{
  "name": "@ayu-sh-kr/dota-preloader-plugin",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "version": "0.0.13",
  "description": "dota-vite-preloader-plugin is a Vite plugin that preloads Web Components for Dota Core Web Apps. It scans the specified directory for Web Component files, generates a preload script, and injects it into the HTML. This ensures that Web Components are loaded and ready to use when the application starts.",
  "author": {
    "name": "ayu-sh-kr",
    "email": "akjaiswal2003@gmail.com",
    "url": "https://linkedin.com/in/ayu-sh-kr"
  },
  "license": "MIT",
  "keywords": [
    "Dota Core Plugins",
    "Web Components",
    "Web Component Loader"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module": "./dist/index.mjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && vite build",
    "release": "pnpm run build && changeset publish",
    "test": "tsc --noEmit && vitest run"
  },
  "dependencies": {
    "@ayu-sh-kr/dota-core": "workspace:*",
    "@ayu-sh-kr/dota-router": "workspace:*",
    "@ayu-sh-kr/dota-ast-utils": "workspace:*",
    "@swc/core": "catalog:",
    "fast-glob": "catalog:",
    "consola": "catalog:",
    "reflect-metadata": "catalog:"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "catalog:",
    "@types/node": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "vite": "catalog:peer-vite"
  },
  "files": [
    "dist/",
    "README.md",
    "package.json"
  ]
}
