{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "declarationDir": "dist/types",
    "outDir": "dist",
    "noEmit": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".",
    "types": ["node", "dom-navigation", "vitest/globals"],
    "lib": ["ES2020", "DOM"],
    /* Path */
    "paths": {
      "@dota/*": ["./src/*"],
      "@test/*": ["./test/*"]
    }
  },
  "include": ["src/**/*",
    "test"
  ],
  "exclude": ["node_modules", "dist"]
}
