{
  "name": "@ayu-sh-kr/dota-rest",
  "version": "1.1.6",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "fetch",
    "http-client",
    "rest-client",
    "rest-api",
    "fetch-api"
  ],
  "author": {
    "name": "ayu-sh-kr",
    "email": "akjaiswal2003@gmail.com",
    "url": "https://linkedin.com/in/ayu-sh-kr"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ayu-sh-kr/dota-rest"
  },
  "description": "@ayu-sh-kr/dota-rest is a simple, intuitive and fluent Rest Client base on the 'fetch' API",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "typings": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "lint": "tsc",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "release": "pnpm run build && changeset publish",
    "test": "tsc --noEmit && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist/",
    "README.md",
    "package.json"
  ]
}
