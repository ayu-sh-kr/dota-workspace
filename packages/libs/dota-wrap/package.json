{
  "name": "@ayu-sh-kr/dota-wrap",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "version": "0.0.7",
  "description": "dota-wrap have bunch of plugins to ease the development of web apps using dota ecosystem.",
  "author": {
    "name": "ayu-sh-kr",
    "email": "akjaiswal2003@gmail.com",
    "url": "https://linkedin.com/in/ayu-sh-kr"
  },
  "license": "MIT",
  "keywords": [
    "Dota Core Plugins",
    "Web Components"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module": "./dist/index.mjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "release": "pnpm run build && changeset publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ayu-sh-kr/dota-core": "workspace:*",
    "@ayu-sh-kr/dota-router": "workspace:*"
  },
  "files": [
    "dist/",
    "README.md",
    "package.json"
  ]
}
