{
  "name": "@ayu-sh-kr/dota-wrap",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "version": "0.0.27",
  "description": "dota-wrap have bunch of plugins to ease the development of web apps using dota ecosystem.",
  "author": {
    "name": "ayu-sh-kr",
    "email": "akjaiswal2003@gmail.com",
    "url": "https://linkedin.com/in/ayu-sh-kr"
  },
  "license": "MIT",
  "keywords": [
    "Dota Core Plugins",
    "Web Components"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module": "./dist/index.mjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "module": "./dist/core/index.mjs",
      "import": "./dist/core/index.mjs",
      "require": "./dist/core/index.cjs",
      "default": "./dist/core/index.mjs"
    },
    "./rendering": {
      "types": "./dist/rendering/index.d.ts",
      "module": "./dist/rendering/index.mjs",
      "import": "./dist/rendering/index.mjs",
      "require": "./dist/rendering/index.cjs",
      "default": "./dist/rendering/index.mjs"
    },
    "./event": {
      "types": "./dist/event/index.d.ts",
      "module": "./dist/event/index.mjs",
      "import": "./dist/event/index.mjs",
      "require": "./dist/event/index.cjs",
      "default": "./dist/event/index.mjs"
    },
    "./router": {
      "types": "./dist/router/index.d.ts",
      "module": "./dist/router/index.mjs",
      "import": "./dist/router/index.mjs",
      "require": "./dist/router/index.cjs",
      "default": "./dist/router/index.mjs"
    },
    "./rest": {
      "types": "./dist/rest/index.d.ts",
      "module": "./dist/rest/index.mjs",
      "import": "./dist/rest/index.mjs",
      "require": "./dist/rest/index.cjs",
      "default": "./dist/rest/index.mjs"
    },
    "./ssr": {
      "types": "./dist/ssr/index.d.ts",
      "module": "./dist/ssr/index.mjs",
      "import": "./dist/ssr/index.mjs",
      "require": "./dist/ssr/index.cjs",
      "default": "./dist/ssr/index.mjs"
    },
    "./ssg": {
      "types": "./dist/ssg/index.d.ts",
      "module": "./dist/ssg/index.mjs",
      "import": "./dist/ssg/index.mjs",
      "require": "./dist/ssg/index.cjs",
      "default": "./dist/ssg/index.mjs"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "module": "./dist/vite/index.mjs",
      "import": "./dist/vite/index.mjs",
      "require": "./dist/vite/index.cjs",
      "default": "./dist/vite/index.mjs"
    },
    "./preloader-plugin": {
      "types": "./dist/preloader-plugin/index.d.ts",
      "module": "./dist/preloader-plugin/index.mjs",
      "import": "./dist/preloader-plugin/index.mjs",
      "require": "./dist/preloader-plugin/index.cjs",
      "default": "./dist/preloader-plugin/index.mjs"
    },
    "./event-map-generator": {
      "types": "./dist/event-map-generator/index.d.ts",
      "module": "./dist/event-map-generator/index.mjs",
      "import": "./dist/event-map-generator/index.mjs",
      "require": "./dist/event-map-generator/index.cjs",
      "default": "./dist/event-map-generator/index.mjs"
    },
    "./web-type-json": {
      "types": "./dist/web-type-json/index.d.ts",
      "module": "./dist/web-type-json/index.mjs",
      "import": "./dist/web-type-json/index.mjs",
      "require": "./dist/web-type-json/index.cjs",
      "default": "./dist/web-type-json/index.mjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "preview": "vite preview",
    "release": "pnpm run build && changeset publish",
    "test": "tsc --noEmit && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ayu-sh-kr/dota-core": "workspace:*",
    "@ayu-sh-kr/dota-event": "workspace:*",
    "@ayu-sh-kr/dota-ssr": "workspace:*",
    "@ayu-sh-kr/dota-rendering": "workspace:*",
    "@ayu-sh-kr/dota-rest": "workspace:*",
    "@ayu-sh-kr/dota-router": "workspace:*",
    "@ayu-sh-kr/dota-runtime": "workspace:*",
    "@swc/core": "catalog:",
    "consola": "catalog:",
    "fast-glob": "catalog:",
    "happy-dom": "catalog:"
  },
  "devDependencies": {
    "@ayu-sh-kr/dota-preloader-plugin": "workspace:*",
    "@ayu-sh-kr/dota-event-map-generator": "workspace:*",
    "@ayu-sh-kr/dota-web-type-json": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "reflect-metadata": "catalog:peer-reflect-metadata",
    "vite": "catalog:peer-vite"
  },
  "files": [
    "dist/",
    "README.md",
    "package.json"
  ]
}
