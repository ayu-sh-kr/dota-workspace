{
  "name": "@ayu-sh-kr/dota-wrap",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "version": "0.0.13",
  "description": "dota-wrap have bunch of plugins to ease the development of web apps using dota ecosystem.",
  "author": {
    "name": "ayu-sh-kr",
    "email": "akjaiswal2003@gmail.com",
    "url": "https://linkedin.com/in/ayu-sh-kr"
  },
  "license": "MIT",
  "keywords": [
    "Dota Core Plugins",
    "Web Components"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module": "./dist/index.mjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "module": "./dist/core/index.mjs",
      "import": "./dist/core/index.mjs",
      "require": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./event": {
      "types": "./dist/event/index.d.ts",
      "module": "./dist/event/index.mjs",
      "import": "./dist/event/index.mjs",
      "require": "./dist/event/index.js",
      "default": "./dist/event/index.js"
    },
    "./router": {
      "types": "./dist/router/index.d.ts",
      "module": "./dist/router/index.mjs",
      "import": "./dist/router/index.mjs",
      "require": "./dist/router/index.js",
      "default": "./dist/router/index.js"
    },
    "./rest": {
      "types": "./dist/rest/index.d.ts",
      "module": "./dist/rest/index.mjs",
      "import": "./dist/rest/index.mjs",
      "require": "./dist/rest/index.js",
      "default": "./dist/rest/index.js"
    },
    "./preloader-plugin": {
      "types": "./dist/preloader-plugin/index.d.ts",
      "module": "./dist/preloader-plugin/index.mjs",
      "import": "./dist/preloader-plugin/index.mjs",
      "require": "./dist/preloader-plugin/index.js",
      "default": "./dist/preloader-plugin/index.js"
    },
    "./web-type-json": {
      "types": "./dist/web-type-json/index.d.ts",
      "module": "./dist/web-type-json/index.mjs",
      "import": "./dist/web-type-json/index.mjs",
      "require": "./dist/web-type-json/index.js",
      "default": "./dist/web-type-json/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "release": "pnpm run build && changeset publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ayu-sh-kr/dota-core": "workspace:*",
    "@ayu-sh-kr/dota-event": "workspace:*",
    "@ayu-sh-kr/dota-preloader-plugin": "workspace:*",
    "@ayu-sh-kr/dota-rest": "workspace:*",
    "@ayu-sh-kr/dota-router": "workspace:*",
    "@ayu-sh-kr/dota-web-type-json": "workspace:*"
  },
  "files": [
    "dist/",
    "README.md",
    "package.json"
  ]
}
