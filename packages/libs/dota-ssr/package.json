{
  "name": "@ayu-sh-kr/dota-ssr",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "version": "0.6.1",
  "description": "Opt-in static generation and hydration extensions for Dota web applications.",
  "keywords": [
    "dota",
    "hydration",
    "ssg",
    "vite-plugin",
    "web-components"
  ],
  "author": {
    "name": "ayu-sh-kr",
    "email": "akjaiswal2003@gmail.com",
    "url": "https://linkedin.com/in/ayu-sh-kr"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/ssr/server-globals.mjs",
    "./dist/ssr/server-globals.cjs"
  ],
  "types": "./dist/index.d.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "exports": {
    "./worker": "./dist/ssg/render-worker.cjs",
    ".": {
      "types": "./dist/index.d.ts",
      "module": "./dist/index.mjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "module": "./dist/vite/index.mjs",
      "import": "./dist/vite/index.mjs",
      "require": "./dist/vite/index.cjs",
      "default": "./dist/vite/index.mjs"
    },
    "./server": {
      "types": "./dist/ssr/index.d.ts",
      "module": "./dist/ssr/index.mjs",
      "import": "./dist/ssr/index.mjs",
      "require": "./dist/ssr/index.cjs",
      "default": "./dist/ssr/index.mjs"
    },
    "./node": {
      "types": "./dist/ssr/node.d.ts",
      "module": "./dist/ssr/node.mjs",
      "import": "./dist/ssr/node.mjs",
      "require": "./dist/ssr/node.cjs",
      "default": "./dist/ssr/node.mjs"
    }
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "release": "pnpm run build && changeset publish",
    "test": "tsc --noEmit && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "playground": "node playground/light-dom/server.mjs"
  },
  "dependencies": {
    "@ayu-sh-kr/dota-common-utils": "workspace:*",
    "@ayu-sh-kr/dota-core": "workspace:*",
    "@ayu-sh-kr/dota-rendering": "workspace:*",
    "@ayu-sh-kr/dota-router": "workspace:*",
    "@ayu-sh-kr/dota-runtime": "workspace:*",
    "@ayu-sh-kr/dota-server-dom": "workspace:*",
    "consola": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "happy-dom": "^20.8.8",
    "vite": "catalog:peer-vite"
  },
  "peerDependenciesMeta": {
    "happy-dom": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "files": [
    "dist/",
    "README.md",
    "package.json"
  ]
}
