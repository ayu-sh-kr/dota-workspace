{
  "name": "@ayu-sh-kr/dota-ui",
  "private": false,
  "version": "0.0.27",
  "publishConfig": {
    "access": "public"
  },
  "description": "Dota-UI is a web component library that provides various regular use components for development. It works out of the box with all the popular javascript frameworks that support web component",
  "type": "module",
  "author": "ayu-sh-kr",
  "license": "MIT",
  "keywords": [
    "UI Library",
    "Web Components",
    "Sleek Design"
  ],
  "types": "./dist/index.d.ts",
  "main": "./dist/dota-ui.cjs",
  "module": "./dist/dota-ui.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module": "./dist/dota-ui.mjs",
      "import": "./dist/dota-ui.mjs",
      "require": "./dist/dota-ui.cjs",
      "default": "./dist/dota-ui.cjs"
    },
    "./dota-ui.css": "./dist/dota-ui.css"
  },
  "files": [
    "dist",
    "web-types.json"
  ],
  "scripts": {
    "dev": "vite",
    "lint": "tsc",
    "build": "tsc && vite build",
    "build-pack": "pnpm build && pnpm pack",
    "preview": "vite preview",
    "release": "pnpm run build && changeset publish",
    "test": "tsc --noEmit && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@ayu-sh-kr/dota-event-map-generator": "workspace:*",
    "@microsoft/api-extractor": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "autoprefixer": "catalog:",
    "happy-dom": "catalog:",
    "postcss": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@ayu-sh-kr/dota-core": "workspace:*",
    "@ayu-sh-kr/dota-event": "workspace:*",
    "@ayu-sh-kr/dota-web-type-json": "workspace:*",
    "@floating-ui/dom": "catalog:"
  },
  "web-types": "./web-types.json"
}
