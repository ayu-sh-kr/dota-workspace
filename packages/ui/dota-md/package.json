{
  "name": "@ayu-sh-kr/dota-md",
  "private": false,
  "version": "0.0.2",
  "publishConfig": {
    "access": "public"
  },
  "description": "dota-md is a web component elements to help user host better docs and blogs.",
  "type": "module",
  "author": "ayu-sh-kr",
  "license": "MIT",
  "keywords": [
    "@ayu-sh-kr/dota-md",
    "dota-md",
    "web component",
    "markdown",
    "docs",
    "blog"
  ],
  "types": "./dist/index.d.ts",
  "main": "./dist/dota-md.cjs",
  "module": "./dist/dota-md.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module": "./dist/dota-md.mjs",
      "import": "./dist/dota-md.mjs",
      "require": "./dist/dota-md.cjs",
      "default": "./dist/dota-md.cjs"
    },
    "./dota-md.css": "./dist/dota-md.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "lint": "tsc",
    "build": "tsc && vite build",
    "build-pack": "pnpm build && pnpm pack",
    "preview": "vite preview",
    "release": "pnpm run build && changeset publish"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4"
  },
  "dependencies": {
    "@ayu-sh-kr/dota-core": "workspace:*",
    "@ayu-sh-kr/dota-event": "workspace:*",
    "markdown-it": "latest",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-highlightjs": "^4.2.0",
    "markdown-it-toc-done-right": "^4.2.0"
  }
}
