{
  "name": "@ayu-sh-kr/dota-md",
  "private": false,
  "version": "0.0.16",
  "publishConfig": {
    "access": "public"
  },
  "description": "dota-md is a web component elements to help user host better docs and blogs.",
  "type": "module",
  "author": "ayu-sh-kr",
  "license": "MIT",
  "keywords": [
    "@ayu-sh-kr/dota-md",
    "dota-md",
    "web component",
    "markdown",
    "docs",
    "blog"
  ],
  "types": "./dist/index.d.ts",
  "main": "./dist/dota-md.cjs",
  "module": "./dist/dota-md.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module": "./dist/dota-md.mjs",
      "import": "./dist/dota-md.mjs",
      "require": "./dist/dota-md.cjs",
      "default": "./dist/dota-md.cjs"
    },
    "./dota-md.css": "./dist/dota-md.css"
  },
  "files": [
    "dist",
    "web-types.json"
  ],
  "scripts": {
    "dev": "vite",
    "lint": "tsc",
    "build": "tsc && vite build",
    "build-pack": "pnpm build && pnpm pack",
    "preview": "vite preview",
    "release": "pnpm run build && changeset publish"
  },
  "devDependencies": {
    "@ayu-sh-kr/dota-event-map-generator": "workspace:*",
    "@microsoft/api-extractor": "catalog:",
    "@types/markdown-it": "catalog:",
    "@types/node": "catalog:",
    "autoprefixer": "catalog:",
    "postcss": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:"
  },
  "dependencies": {
    "@ayu-sh-kr/dota-core": "workspace:*",
    "@ayu-sh-kr/dota-event": "workspace:*",
    "@ayu-sh-kr/dota-rendering": "workspace:*",
    "@ayu-sh-kr/dota-web-type-json": "workspace:*",
    "markdown-it": "catalog:",
    "markdown-it-anchor": "catalog:",
    "markdown-it-highlightjs": "catalog:",
    "markdown-it-toc-done-right": "catalog:"
  },
  "web-types": "./web-types.json"
}
