{
  "name": "dota-wrap",
  "private": false,
  "version": "0.0.1",
  "description": "dota-wrap have bunch of plugins to ease the development of web system using dota ecosystem.",
  "author": {
    "name": "ayu-sh-kr",
    "email": "akjaiswal2003@gmail.com",
    "url": "linkedin.com/in/ayu-sh-kr"
  },
  "license": "MIT",
  "keywords": ["Dota Core Plugins", "Web Components"],
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module": "./dist/index.mjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ayu-sh-kr/dota-core": "workspace:*",
    "@ayu-sh-kr/dota-router": "workspace:*"
  }
